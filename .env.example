# Copy to .env (repo root) or backend/.env. Read by the FastAPI backend only —
# never exposed to the browser.

# Meta Model API (https://dev.meta.ai/docs)
META_MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=muse-spark-1.3
META_SEGMENTATION_MODEL=sam-3.1
META_IMAGE_MODEL=muse-image-1.0

# Database. SQLite by default; for PostgreSQL install psycopg and use e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/hydrosentinel
# DATABASE_URL=sqlite:///backend/data/hydrosentinel.db

# Open-Meteo needs no key.
OPEN_METEO_CACHE_SECONDS=900

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Live open data (no keys). Measured gauges: UK Environment Agency real-time API.
# Philippine outlook: GloFAS river discharge via the Open-Meteo Flood API.
LIVE_DATA_ENABLED=true
LIVE_REFRESH_MINUTES=15
# true = load the simulated demo stations instead of removing them in live mode.
SEED_DEMO_DATA=false

# Flood-watch agent credit guards.
AGENT_AUTORUN_HOURS=3
AGENT_COOLDOWN_MINUTES=10
AGENT_MAX_RUNS_PER_DAY=40

# Plan B: Meta open-weights Muse Spark Open on Baseten (OpenAI-compatible).
# Swap these three in if the Meta Model API is unavailable:
# META_MODEL_BASE_URL=https://inference.baseten.co/v1
# META_TEXT_MODEL=meta-models/muse-spark-open-1026
# META_MODEL_API_KEY=<your Baseten API key>
